{
  "name": "ai-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "workspaces": [
    "block3"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:all": "playwright test --output=test-results",
    "test:smoke": "playwright test --grep @smoke --output=test-results",
    "test:sanity": "playwright test --grep @sanity --output=test-results",
    "test:regression": "playwright test --grep @regression --output=test-results",
    "test:api": "playwright test --grep @api --output=test-results",
    "test:e2e": "playwright test --grep @e2e --output=test-results",
    "test:destructive": "playwright test --grep @destructive --workers=1 --output=test-results",
    "test:e2e:ui": "playwright test --ui --output=test-results",
    "test:e2e:didaxis": "playwright test tests/ds1-create-program.spec.ts --output=test-results",
    "test:e2e:didaxis-ds2": "playwright test tests/ds2-edit-program.spec.ts --output=test-results",
    "test:e2e:didaxis-ds3": "playwright test tests/ds3-names-validation.spec.ts --output=test-results",
    "test:e2e:block3": "npm run test:e2e -w block3",
    "test:e2e:ui:block3": "npm run test:e2e:ui -w block3",
    "test:e2e:report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-lesley/AI-QA-Automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/alex-lesley/AI-QA-Automation/issues"
  },
  "homepage": "https://github.com/alex-lesley/AI-QA-Automation#readme",
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.9.1"
  }
}
