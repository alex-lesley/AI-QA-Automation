# =============================================================================
# Run tests — required to clone and run Playwright (`npx playwright test`)
# =============================================================================

# Base URL of the Didaxis environment under test
DIDAXIS_URL=https://test.example.com

# Admin (or standard test) user email for UI login / storageState auth setup
DIDAXIS_EMAIL=qa-admin@example.com

# Password for DIDAXIS_EMAIL — never commit the real value
DIDAXIS_PASSWORD=replace-me

# Bearer API token for program list/create/delete helpers and test cleanup
DIDAXIS_API_TOKEN=dt_replace_me_with_a_real_token

# Optional — alternate (non-admin) user for permission / RBAC probe tests
DIDAXIS_ALT_EMAIL=qa-viewer@example.com
DIDAXIS_ALT_PASSWORD=replace-me-alt

# =============================================================================
# Agent / CI setup — not needed for `npx playwright test` alone
# Headless agent: .github/workflows/test-generation.yml
# MCP tokens: also configure in Cursor Settings → MCP (prefer settings over .env)
# =============================================================================

# Cursor API key for the headless `agent` CLI in test-generation workflow
CURSOR_API_KEY=key_replace_me

# Atlassian (Jira) API token for ticket read/write from agents and MCP
ATLASSIAN_API_TOKEN=ATATT_replace_me

# Jira Cloud site URL (trailing slash optional)
ATLASSIAN_BASE_URL=https://your-site.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN
ATLASSIAN_EMAIL=you@example.com
